{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amstrad/cycling-coach-skill/assets/athlete-profile.schema.json",
  "title": "athlete-profile.json",
  "description": "The athlete's personal file. Field meanings are in references/profile-schema.md.",
  "type": "object",
  "required": ["name", "language", "units", "sport", "objective", "age"],
  "$defs": {
    "day": { "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }
  },
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "description": "BCP 47 language tag, e.g. en, es, nl." },
    "units": { "enum": ["metric", "imperial"] },
    "voiceGuidelines": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "sport": { "enum": ["cycling", "running", "both"] },
    "age": { "type": "integer", "minimum": 18, "maximum": 100 },
    "gender": { "enum": ["male", "female", "other", null] },
    "weightKg": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "baselineFtp": { "type": ["integer", "null"], "minimum": 50 },
    "goalWkg": { "type": ["number", "null"] },
    "level": { "enum": ["beginner", "intermediate", "advanced", null] },
    "trainingAgeYears": { "type": ["number", "null"], "minimum": 0 },
    "weeklyHours": { "type": ["number", "null"], "minimum": 0 },
    "eventType": { "enum": ["criterium", "road-race", "gran-fondo", "time-trial", "climb", "5k", "10k", "half-marathon", "marathon", null] },
    "eventDate": { "type": ["string", "null"], "format": "date" },
    "thresholdPaceSecPerKm": { "type": ["integer", "null"], "minimum": 120, "maximum": 600 },
    "lthr": { "type": ["integer", "null"], "minimum": 80, "maximum": 220 },
    "maxHr": { "type": ["integer", "null"], "minimum": 100, "maximum": 230 },
    "weeklyKm": { "type": ["number", "null"], "minimum": 0 },
    "socialDays": { "type": "array", "items": { "$ref": "#/$defs/day" }, "uniqueItems": true },
    "openDays": { "type": "array", "items": { "$ref": "#/$defs/day" }, "uniqueItems": true },
    "usualDurationMin": { "type": "integer", "minimum": 15 },
    "targetedSessionCap": { "type": "integer", "minimum": 1, "maximum": 3 },
    "gymDefault": { "enum": ["strength+core", "core", "none"] },
    "powerProfileOverride": { "enum": ["explosive", "balanced", "steady", null] },
    "exportFormat": { "enum": ["zwo", "intervals", "zwo+intervals"] },
    "intervalsAthleteId": { "type": ["string", "null"], "pattern": "^i?[0-9]+$" },
    "publishToIntervals": { "enum": ["ask", "always", "never"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "trainingState": {
      "type": ["object", "null"],
      "properties": {
        "blockIndex": { "type": "integer", "minimum": 0 },
        "blockType": { "enum": ["3:1", "2:1"] },
        "blockWeek": { "type": "integer", "minimum": 1, "maximum": 5 },
        "patternSteps": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 3 } },
        "lastDeloadWeek": { "type": ["string", "null"], "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "missedKeySessions": { "type": "integer", "minimum": 0 },
        "seasonPlan": { "type": "array", "items": { "type": "object" }, "description": "Week rows from references/season-plan.md." }
      }
    }
  },
  "additionalProperties": true
}

    { "maxWeeklyHours": 10, "easyPct": [75, 80], "thresholdPct": [10, 15], "hiPct": [5, 10] },
    { "maxWeeklyHours": 99, "easyPct": [80, 85], "thresholdPct": [8, 12],  "hiPct": [5, 8] }

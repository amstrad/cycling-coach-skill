    "rampMaxPct": 10,
    "rampTolerancePct": 2,
    "deloadFactor": [0.55, 0.65],
    "ctlRampPerWeek": { "sustained": [3, 5], "maxShortTerm": 7 },
    "acwr": { "low": 0.7, "optimalMax": 1.3, "cautionMax": 1.5 },
    "tsbKeySessionMin": -20,
    "tsbOverreach": -30,
    "raceTsb": [5, 25]
  },

  "pushHold": {
    "keySessionCompletionPct": 95,
